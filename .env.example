HUB_PASSWORD=
HUB_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# Membership applications, Experience United, and Run Club signup email through Resend.
# Do not put real values in git.
# Leave APPLY_TO_EMAIL empty to use membership@unitedstrengthgym.com (MEMBERSHIP_INBOX).
# Only set APPLY_TO_EMAIL if Todd wants a temporary override — otherwise keep it blank on Vercel.
# APPLY_FROM_EMAIL must be a sender Resend has verified before mail can leave the sandbox.
RESEND_API_KEY=
APPLY_FROM_EMAIL=
APPLY_TO_EMAIL=
# Hub password-reset links. Falls back to APPLY_TO_EMAIL, then membership@unitedstrengthgym.com.
HUB_RESET_EMAIL=

# Local dev without HUB_PASSWORD uses the built-in password united-strength-hub.
# Production (VERCEL) refuses login until HUB_PASSWORD and HUB_SESSION_SECRET are set.
# BLOB_READ_WRITE_TOKEN stores the kit for every visitor. Without it, production saves fail
# and local dev writes .data/brand-kit.json instead.

# Archive subscribe — Mailchimp embedded form action URL (POST). Leave unset to fail closed on submit.
VITE_MAILCHIMP_ARCHIVE_ACTION=

# Apply for Membership — Typeform form URL. When set, V1 Apply embeds the form; when unset, Begin → mailto.
VITE_TYPEFORM_APPLY_URL=

# Mariana Tek member embeds (/buy, /schedule, /account). Tenant must allow framing for iframe; else Open↗ fallback.
VITE_MARIANA_TENANT=
VITE_MARIANA_LOCATION_ID=
VITE_MARIANA_REGION_ID=
