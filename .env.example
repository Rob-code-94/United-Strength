HUB_PASSWORD=
HUB_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# Membership applications are emailed through Resend. Do not put real values in git.
# APPLY_TO_EMAIL defaults to membership@unitedstrengthgym.com.
# APPLY_FROM_EMAIL must be a sender Resend has verified before mail can leave the sandbox.
RESEND_API_KEY=
APPLY_FROM_EMAIL=
APPLY_TO_EMAIL=
# Hub password-reset links. Falls back to APPLY_TO_EMAIL, then membership@unitedstrengthgym.com.
HUB_RESET_EMAIL=

# Local dev without HUB_PASSWORD uses the built-in password united-strength-hub.
# Production (VERCEL) refuses login until HUB_PASSWORD and HUB_SESSION_SECRET are set.
# BLOB_READ_WRITE_TOKEN stores the kit for every visitor. Without it, production saves fail
# and local dev writes .data/brand-kit.json instead.
